# FISCO Academy — environment variables
#
# The app runs fully self-contained WITHOUT these (progress + quizzes + certificates
# are stored in the browser). Fill these in only when you wire up the real Supabase
# backend described in supabase/schema.sql.

# Supabase (optional — for shared accounts, admin dashboard across devices, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for admin tasks / seeding (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
